---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HoursTable from '../components/HoursTable.astro';
import Status from '../components/Status.astro';
import Plate from '../components/Plate.astro';
import { useT, type Lang } from '../i18n';
import { site } from '../data/site';
import { bookingOnline, bookingEmbedded, whatsappLink } from '../lib/booking';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const b = t.bookPage;
const o = b.online;
---
<Base lang={lang} page="book" title={t.meta.book.title} description={t.meta.book.description}>
  <PageHero label={b.label} title={b.title} lede={bookingOnline ? o.lede : b.lede} />
  <section class="wrap book">
    {bookingOnline ? (
    <div class="book-online">
      {bookingEmbedded ? (
        <>
          <div class="book-frame">
            <iframe src={site.bookingUrl} title={o.frameTitle} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="payment"></iframe>
          </div>
          <p class="book-note muted"><a class="link" href={site.bookingUrl} target="_blank" rel="noopener" data-track="reserver-laddition">{o.openTab}</a></p>
        </>
      ) : (
        <div class="book-go-wrap">
          <a class="btn btn--primary book-go" href={site.bookingUrl} target="_blank" rel="noopener" data-track="reserver-laddition">{o.cta} <span class="arrow" aria-hidden="true">↗</span><span class="sr-only"> {t.common.newTab}</span></a>
          <p class="book-note muted">{o.note}</p>
        </div>
      )}
      <div class="book-alt">
        <h2 class="label bare">{o.altTitle}</h2>
        <p>{o.altText}</p>
        <div class="book-actions">
          <a class="btn" href={`tel:${site.phoneE164}`} data-track="appel">{b.callCta} · <bdi class="num">{site.phoneDisplay}</bdi></a>
          <a class="btn" href={whatsappLink(o.waMessage)} target="_blank" rel="noopener" data-track="whatsapp">{o.whatsapp}<span class="sr-only"> {t.common.newTab}</span></a>
        </div>
        <p class="field-hint">{b.groups}</p>
      </div>
    </div>
    ) : (
    <form class="book-form" data-book novalidate data-wa={site.whatsappE164}>
      <div class="field">
        <label for="b-date">{b.date}</label>
        <input id="b-date" name="date" type="date" required data-date />
        <p class="field-err" data-err="date" hidden>{b.required}</p>
      </div>
      <div class="field">
        <label for="b-time">{b.time}</label>
        <select id="b-time" name="time" required data-slot disabled>
          <option value="">{b.chooseDate}</option>
        </select>
        <p class="field-hint" data-time-hint hidden></p>
        <p class="field-err" data-err="time" hidden>{b.required}</p>
      </div>
      <div class="field">
        <span class="field-label" id="b-guests-l">{b.guests}</span>
        <div class="stepper" role="group" aria-labelledby="b-guests-l">
          <button type="button" data-step="-1" aria-label={b.less}>−</button>
          <input id="b-guests" name="guests" type="number" inputmode="numeric" min="1" max="12" value="2" aria-labelledby="b-guests-l" data-guests />
          <button type="button" data-step="1" aria-label={b.more}>+</button>
        </div>
        <p class="field-hint">{b.groups}</p>
      </div>
      <div class="field">
        <label for="b-name">{b.name}</label>
        <input id="b-name" name="name" type="text" autocomplete="name" required maxlength="80" />
        <p class="field-err" data-err="name" hidden>{b.required}</p>
      </div>
      <div class="field field--wide">
        <label for="b-note">{b.note}</label>
        <textarea id="b-note" name="note" rows="3" maxlength="300" placeholder={b.notePh}></textarea>
      </div>
      <div class="book-actions field--wide">
        <button class="btn btn--primary book-submit" type="submit" data-track="whatsapp">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
          {b.submit}
        </button>
        <span class="muted">{b.or}</span>
        <a class="btn" href={`tel:${site.phoneE164}`} data-track="appel">{b.callCta} · <bdi class="num">{site.phoneDisplay}</bdi></a>
      </div>
      <p class="book-confirm muted field--wide">{b.confirm}</p>
      <p class="book-sent field--wide" role="status" data-sent hidden>{b.sent}</p>
    </form>
    )}

    <aside class="book-aside">
      <div class="book-plate" aria-hidden="true"><Plate name="carpaccio-poisson-truffe" alt="" sizes="(min-width: 900px) 26vw, 60vw" /></div>
      <h2 class="label bare">{b.asideTitle}</h2>
      <Status text={t.status.loading} />
      <HoursTable lang={lang} />
      <address class="book-address"><bdi>{site.street}, {site.postalCode} {site.city}</bdi><br /><span class="muted">{t.common.metro}</span></address>
    </aside>
  </section>
</Base>

<style>
  .book { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(40px, 7vw, 120px); padding-bottom: var(--section); align-items: start; }
  .book-form { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 24px; }
  .field { display: grid; gap: 10px; align-content: start; }
  .field--wide { grid-column: 1 / -1; }
  .field label, .field-label { font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--gold); }
  .field input, .field select, .field textarea { width: 100%; min-height: 56px; padding: 0 2px; font: inherit; font-size: 20px; color: var(--fg); background: transparent; border: 0; border-bottom: 1px solid color-mix(in srgb, var(--fg) 35%, transparent); border-radius: 0; transition: border-color .3s var(--ease); -webkit-appearance: none; appearance: none; }
  .field select { background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%); background-position: calc(100% - 14px) 50%, calc(100% - 9px) 50%; background-size: 5px 5px; background-repeat: no-repeat; padding-inline-end: 28px; }
  :global([dir='rtl']) .field select { background-position: 9px 50%, 14px 50%; }
  .field select:disabled { opacity: .5; }
  .field textarea { padding-block: 14px; min-height: 96px; resize: vertical; font-size: 17px; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-bottom-color: var(--accent); box-shadow: 0 1px 0 0 var(--accent); }
  .field input[aria-invalid='true'], .field select[aria-invalid='true'] { border-bottom-color: #b8644f; }
  .field input[type='date']::-webkit-calendar-picker-indicator { filter: var(--photo-filter); cursor: pointer; opacity: .7; }
  :root[data-time='night'] .field input[type='date']::-webkit-calendar-picker-indicator { filter: invert(1); }
  .field-hint, .field-err { margin: 0; font-size: 13px; color: var(--fg-soft); }
  .field-err { color: #b8644f; }
  :root[data-time='night'] .field-err { color: #e3957f; }
  .stepper { display: grid; grid-template-columns: 56px 1fr 56px; align-items: center; border-bottom: 1px solid color-mix(in srgb, var(--fg) 35%, transparent); }
  .stepper button { min-height: 56px; font-size: 24px; border-radius: 50%; }
  @media (hover: hover) { .stepper button:hover { color: var(--accent); } }
  .stepper input { text-align: center; border: 0; min-height: 56px; -moz-appearance: textfield; }
  .stepper input::-webkit-inner-spin-button, .stepper input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .book-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; margin-top: 8px; }
  .book-submit svg { flex: none; }
  .book-confirm { font-size: 14px; margin: 0; }
  .book-sent { margin: 0; padding: 14px 18px; border-radius: 4px; background: color-mix(in srgb, #4f9a68 14%, transparent); }
  .book-online { display: grid; gap: 40px; align-content: start; }
  .book-go-wrap { display: grid; gap: 14px; justify-items: start; }
  .book-go { min-height: 64px; padding-inline: 36px; font-size: 17px; }
  .book-note { margin: 0; font-size: 14px; }
  .book-frame { border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: #fff; }
  .book-frame iframe { display: block; width: 100%; height: min(860px, 86vh); border: 0; }
  .book-alt { display: grid; gap: 14px; padding-top: 32px; border-top: 1px solid var(--line); }
  .book-alt p { margin: 0; }
  .book-alt .book-actions { margin-top: 4px; }
  .book-aside { position: sticky; top: calc(var(--header) + 32px); display: grid; gap: 18px; }
  .book-plate { width: min(260px, 70%); margin-bottom: 8px; }
  .book-plate :global(img) { width: 100%; animation: spin 70s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .book-address { font-style: normal; font-size: 15px; line-height: 1.6; }
  @media (max-width: 900px) {
    .book { grid-template-columns: 1fr; }
    .book-form { grid-template-columns: 1fr; }
    .book-aside { position: static; }
    .book-plate { display: none; }
    .book-actions .btn { width: 100%; }
    .book-actions > span { display: none; }
    .book-go-wrap, .book-go { width: 100%; }
  }
</style>
<script>
  import '../scripts/reserve';
</script>
