---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Plate from '../components/Plate.astro';
import { useT, href, type Lang } from '../i18n';
import { dish } from '../data/menu';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const s = t.storyPage;
const gallery = [
  { name: 'carpaccio-thon', alt: 'Carpaccio' },
  { name: 'nems-chevre-noix', alt: dish('cigares-chevre').name[lang] },
  { name: 'pizza-roquette-tomates-sechees', alt: 'Pizza' },
  { name: 'tartare-saumon-avocat', alt: dish('tartare-saumon').name[lang] },
  { name: 'california-saumon-avocat', alt: 'California rolls' },
  { name: 'sashimi-saumon-riz', alt: 'Sashimi' },
];
---
<Base lang={lang} page="story" title={t.meta.story.title} description={t.meta.story.description}>
  <PageHero label={s.label} title={s.title} lede={s.lede} />

  <div class="wrap">
    <figure class="story-wide photo" data-reveal>
      <Photo name="table-partagee-vue-ensemble" alt={t.home.day.moments[2].alt} sizes="100vw" eager />
    </figure>
  </div>

  <section class="section">
    <div class="wrap story-chapters">
      {s.chapters.map((c, i) => (
        <article class="chapter" data-reveal>
          <p class="label"><span class="n">{String(i + 1).padStart(2, '0')}</span>{c.k}</p>
          <h2 class="display-xl">{c.title}</h2>
          <div class="chapter-text">{c.text.map((p) => <p>{p}</p>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="story-values theme-surface">
    <div class="wrap story-values-grid">
      <div>
        <h2 class="display-l">{s.valuesTitle}</h2>
        <div class="story-plate" aria-hidden="true"><Plate name="carpaccio-thon" alt="" sizes="(min-width: 900px) 28vw, 70vw" /></div>
      </div>
      <ol>
        {t.home.maison.values.map((v, i) => (
          <li data-reveal={i}>
            <span class="num story-n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display-m">{v.title}</h3>
            <p class="muted">{v.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="kosher" data-reveal>
        <p class="label bare">{t.common.kosher}</p>
        <h2 class="display-l">{s.kosherTitle}</h2>
        <p class="lede">{s.kosherText}</p>
      </div>
      <h2 class="display-l story-gallery-title">{s.galleryTitle}</h2>
      <ul class="story-gallery">
        {gallery.map((g, i) => (
          <li class="photo" data-reveal={i % 3}><Photo name={g.name} alt={g.alt} sizes="(min-width: 900px) 33vw, 50vw" /></li>
        ))}
      </ul>
      <div class="btn-row story-cta">
        <a class="btn btn--primary" href={href(lang, 'book')} data-track="reserver-maison">{t.common.book} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href={href(lang, 'menu')}>{t.common.seeMenu}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .story-wide { aspect-ratio: 21 / 9; border-radius: 4px; }
  .story-chapters { display: grid; gap: clamp(72px, 9vw, 140px); }
  .chapter { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 18px clamp(24px, 5vw, 80px); align-items: start; }
  .chapter .label { grid-column: 1 / -1; }
  .chapter h2 { color: var(--accent); transition: color var(--t-theme) var(--ease); }
  :root[data-time='night'] .chapter h2 { color: var(--fg); }
  .chapter-text p { font-size: clamp(18px, 1.5vw, 22px); line-height: 1.55; max-width: 52ch; }
  .story-values { background: #24474f; color: #f4eee3; --fg-soft: #c3d0cd; --line: rgba(244, 238, 227, .22); --gold: #d9b97f; padding-block: var(--section); }
  :root[data-time='night'] .story-values { background: #13262b; }
  .story-values-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .story-plate { width: min(100%, 380px); margin-top: 48px; }
  .story-plate :global(img) { width: 100%; animation: spin 80s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .story-values ol { display: grid; gap: 0; }
  .story-values li { padding: 28px 0; border-top: 1px solid var(--line); }
  .story-n { display: block; font-size: 13px; letter-spacing: .2em; color: var(--gold); margin-bottom: 12px; }
  .story-values h3 { margin-bottom: 10px; }
  .story-values p { margin: 0; max-width: 46ch; }
  .kosher { max-width: 820px; display: grid; gap: 18px; margin-bottom: clamp(72px, 9vw, 140px); }
  .kosher p { margin: 0; }
  .story-gallery-title { margin-bottom: 32px; }
  .story-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1.4vw, 20px); }
  .story-gallery li { aspect-ratio: 5 / 4; }
  .story-cta { margin-top: 48px; }
  @media (max-width: 900px) {
    .story-wide { aspect-ratio: 4 / 3; }
    .chapter, .story-values-grid { grid-template-columns: 1fr; }
    .story-gallery { grid-template-columns: 1fr 1fr; }
  }
</style>
