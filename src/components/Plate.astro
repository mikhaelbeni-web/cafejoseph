---
// Cutout plate (square WebP with transparency, 640 and 1200 px).
interface Props { name: string; alt: string; sizes?: string; class?: string; eager?: boolean; [k: string]: unknown }
const { name, alt, sizes = '(min-width: 900px) 40vw, 80vw', class: cls = '', eager = false, ...rest } = Astro.props;
---
<img
  class={`plate ${cls}`}
  src={`/img/assiettes/${name}-640.webp`}
  srcset={`/img/assiettes/${name}-640.webp 640w, /img/assiettes/${name}-1200.webp 1200w`}
  sizes={sizes}
  width="1200" height="1200"
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  {...rest}
/>
