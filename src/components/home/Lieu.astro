---
import Plate from '../Plate.astro';
import { useT, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const l = t.home.lieu;
const ring = l.stamp.repeat(2);
---
<section class="lieu" aria-labelledby="lieu-title">
  <div class="wrap lieu-grid">
    <div class="lieu-copy">
      <p class="label"><span class="n">06</span>{l.label}</p>
      <h2 id="lieu-title" class="display-xl" data-reveal>{l.title}</h2>
      <p class="lieu-text" data-reveal="1">{l.text}</p>
      <dl class="lieu-facts">
        {l.facts.map((f) => (
          <div>
            <dt class="label bare">{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="lieu-visual" aria-hidden="true">
      <svg class="lieu-stamp" viewBox="0 0 300 300" data-lieu-stamp>
        <defs><path id="lieu-circle" d="M150,150 m-128,0 a128,128 0 1,1 256,0 a128,128 0 1,1 -256,0" /></defs>
        <circle cx="150" cy="150" r="146" />
        <circle cx="150" cy="150" r="110" />
        <text><textPath href="#lieu-circle" textLength="800">{ring}</textPath></text>
      </svg>
      <div class="lieu-plate">
        <Plate name="rigatoni-aubergines" alt="" sizes="(min-width: 900px) 24vw, 52vw" />
      </div>
    </div>
  </div>
</section>

<style>
  .lieu { --fg: #f4eee3; --fg-soft: #c3d0cd; --line: rgba(244, 238, 227, .22); --gold: #d9b97f;
    background: #24474f; color: var(--fg); padding-block: var(--section); overflow: clip; transition: background-color var(--t-theme) var(--ease); }
  :root[data-time='night'] .lieu { background: #13262b; }
  .lieu-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .lieu-copy h2 { margin: 24px 0 28px; }
  .lieu-text { font-size: clamp(18px, 1.45vw, 21px); color: var(--fg-soft); max-width: 42ch; }
  .lieu-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 40px 0 0; }
  .lieu-facts div { border-top: 1px solid var(--line); padding-top: 16px; }
  .lieu-facts dd { margin: 8px 0 0; font-family: var(--display); font-size: clamp(20px, 1.8vw, 26px); line-height: 1.15; }
  .lieu-visual { position: relative; aspect-ratio: 1; width: 100%; max-width: 520px; justify-self: center; }
  .lieu-stamp { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 60s linear infinite; }
  .lieu-stamp circle { fill: none; stroke: rgba(217, 185, 127, .5); stroke-width: .6; }
  .lieu-stamp text { fill: #d9b97f; font-family: var(--sans); font-size: 12.5px; letter-spacing: 3px; font-weight: 600; }
  .lieu-plate { position: absolute; inset: 21%; }
  .lieu-plate :global(img) { width: 100%; height: 100%; animation: spin 90s linear infinite reverse; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 900px) {
    .lieu-grid { grid-template-columns: 1fr; }
    .lieu-visual { max-width: 340px; order: -1; }
    .lieu-facts { grid-template-columns: 1fr 1fr; }
  }
</style>
