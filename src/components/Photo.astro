---
// Shoot photo (WebP, 800 and 1600 px wide, 5:4).
interface Props { name: string; alt: string; sizes?: string; class?: string; eager?: boolean; }
const { name, alt, sizes = '(min-width: 900px) 50vw, 100vw', class: cls = '', eager = false } = Astro.props;
---
<img
  class={cls}
  src={`/img/plats/${name}-800.webp`}
  srcset={`/img/plats/${name}-800.webp 800w, /img/plats/${name}-1600.webp 1600w`}
  sizes={sizes}
  width="1600" height="1280"
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
